# Settings of the deployed DYCI Campus Claim Check. Every CAMPUS_VERIFY_* behaviour is OFF unless set here.
# Copy to your environment (or a start script). Replace every <...> value with your own.

# --- Serving ---------------------------------------------------------------------------------------------------------
CAMPUS_VERIFY_SERVE_FRONTEND=1
CAMPUS_VERIFY_PUBLIC=1
CAMPUS_VERIFY_PUBLIC_ORIGIN=<https://your-public-address>
CAMPUS_VERIFY_HARDENING=1
CAMPUS_VERIFY_TRUST_PROXY=0
CAMPUS_VERIFY_RATE_LIMIT_PER_MINUTE=150
CAMPUS_VERIFY_URL_RATE_LIMIT_PER_MINUTE=40
CAMPUS_VERIFY_IMAGE_RATE_LIMIT_PER_MINUTE=30
CAMPUS_VERIFY_QUEUE_SECONDS=30
CAMPUS_VERIFY_ANSWER_REUSE=1

# --- Sign-in and accounts --------------------------------------------------------------------------------------------
CAMPUS_VERIFY_AUTH=google
CAMPUS_VERIFY_AUTH_REQUIRED=1
CAMPUS_VERIFY_GOOGLE_CLIENT_ID=<your Google OAuth client ID>
CAMPUS_VERIFY_ADMIN_EMAILS=<admin@your-school.edu>
CAMPUS_VERIFY_SESSION_IDLE_MINUTES=30
CAMPUS_VERIFY_HISTORY=1
CAMPUS_VERIFY_RETENTION=1

# --- Picture check ---------------------------------------------------------------------------------------------------
CAMPUS_VERIFY_IMAGE=1
CAMPUS_VERIFY_IMAGE_PROVENANCE=1
CAMPUS_VERIFY_POSTER_LANGUAGE=1
CAMPUS_VERIFY_POSTER_DATES=1
CAMPUS_VERIFY_CHANGED_DATE=1
CAMPUS_VERIFY_PICTURE_TEXT_LINE=1

# --- Checking rules (each passed its own pre-registered test, or was adopted by the owner after one) ------------------
CAMPUS_VERIFY_LOOKALIKE=1
CAMPUS_VERIFY_SAME_DAY_LOOKUP=1
CAMPUS_VERIFY_HEADER_DATE=1
CAMPUS_VERIFY_SAME_DAY_JUDGE=1
CAMPUS_VERIFY_REASON_PARTS=1
CAMPUS_VERIFY_LINK_SOURCE=1
CAMPUS_VERIFY_UNIT_CHECK=1
CAMPUS_VERIFY_VALUE_WITHHOLD=1
CAMPUS_VERIFY_CLASS_WORDING=1

# --- Sources -----------------------------------------------------------------------------------------------------------
CAMPUS_VERIFY_SOURCES=1
CAMPUS_VERIFY_SOURCES_FETCH_MINUTES=60
CAMPUS_VERIFY_SOURCES_BACKFILL_MINUTES=10
CAMPUS_VERIFY_FB_REFRESH_MINUTES=10
CAMPUS_VERIFY_FETCH_STATUS=1
CAMPUS_VERIFY_OFFICIAL_PAGES=<official page names or ids, comma-separated>
CAMPUS_VERIFY_ORG_PAGES=31
CAMPUS_VERIFY_ORG_RELATED_FALLBACK=1
CAMPUS_VERIFY_ORG_SOURCES=<key=Display name, e.g. dept_page=Department name>

# --- Page extras -------------------------------------------------------------------------------------------------------
CAMPUS_VERIFY_UI_EXTRAS=1
CAMPUS_VERIFY_TOUR=1
CAMPUS_VERIFY_STATS=1
CAMPUS_VERIFY_STATS_FILE=<path to a counts file outside the repository>
CAMPUS_VERIFY_REQUEST_LOG=1
